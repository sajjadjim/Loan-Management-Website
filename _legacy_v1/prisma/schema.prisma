// Prisma schema for Loan / Member Management System
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
  VIEWER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LoanStatus {
  PENDING
  ACTIVE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum InterestType {
  FLAT
  REDUCING
}

enum InstallmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum TransactionType {
  LOAN_DISBURSEMENT
  INSTALLMENT_PAYMENT
  SAVINGS_DEPOSIT
  SAVINGS_WITHDRAWAL
  ADJUSTMENT
  REVERSAL
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         Role          @default(STAFF)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Customer {
  id                 String             @id @default(uuid())
  memberCode         String             @unique // e.g. MEM-0128
  fullName           String
  fatherHusbandName  String?
  phone              String
  address            String?
  nidNumber          String?
  joiningDate        DateTime           @default(now())
  status             CustomerStatus     @default(ACTIVE)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          CustomerDocument[]
  loans              Loan[]
  savingsAccount     SavingsAccount?
  transactions       Transaction[]

  @@index([memberCode])
  @@index([phone])
  @@index([status])
  @@map("customers")
}

model CustomerDocument {
  id           String   @id @default(uuid())
  customerId   String
  fileId       String   // Storage / Google Drive reference ID
  fileName     String
  fileType     String
  fileSize     Int
  driveViewUrl String?
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_documents")
}

model Loan {
  id                String               @id @default(uuid())
  customerId        String
  loanCode          String               @unique // e.g. LN-2026-001
  loanAmount        Decimal              @db.Decimal(12, 2)
  interestRate      Decimal              @db.Decimal(5, 2)
  interestType      InterestType         @default(FLAT)
  loanPurpose       String?
  startDate         DateTime
  durationMonths    Int                  @default(12)
  frequency         InstallmentFrequency @default(MONTHLY)
  totalInstallments Int
  installmentAmount Decimal              @db.Decimal(12, 2)
  totalPayable      Decimal              @db.Decimal(12, 2)
  totalInterest     Decimal              @db.Decimal(12, 2)
  paidAmount        Decimal              @default(0.00) @db.Decimal(12, 2)
  remainingAmount   Decimal              @db.Decimal(12, 2)
  status            LoanStatus           @default(ACTIVE)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  customer     Customer          @relation(fields: [customerId], references: [id])
  installments LoanInstallment[]
  transactions Transaction[]

  @@index([customerId])
  @@index([loanCode])
  @@index([status])
  @@map("loans")
}

model LoanInstallment {
  id                String            @id @default(uuid())
  loanId            String
  installmentNo     Int
  dueDate           DateTime
  principalAmount   Decimal           @db.Decimal(12, 2)
  interestAmount    Decimal           @db.Decimal(12, 2)
  totalDue          Decimal           @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0.00) @db.Decimal(12, 2)
  remainingAmount   Decimal           @db.Decimal(12, 2)
  status            InstallmentStatus @default(PENDING)
  paidDate          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([status])
  @@index([dueDate])
  @@map("loan_installments")
}

model SavingsAccount {
  id             String        @id @default(uuid())
  customerId     String        @unique
  currentBalance Decimal       @default(0.00) @db.Decimal(12, 2)
  totalDeposited Decimal       @default(0.00) @db.Decimal(12, 2)
  totalWithdrawn Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@map("savings_accounts")
}

model Transaction {
  id               String          @id @default(uuid())
  transactionCode  String          @unique // e.g. TXN-100001
  customerId       String
  loanId           String?
  savingsAccountId String?
  transactionDate  DateTime        @default(now())
  type             TransactionType
  amount           Decimal         @db.Decimal(12, 2)
  referenceNo      String?
  description      String?
  isVoided         Boolean         @default(false)
  createdBy        String
  createdAt        DateTime        @default(now())

  customer       Customer        @relation(fields: [customerId], references: [id])
  loan           Loan?           @relation(fields: [loanId], references: [id])
  savingsAccount SavingsAccount? @relation(fields: [savingsAccountId], references: [id])
  user           User            @relation(fields: [createdBy], references: [id])

  @@index([customerId])
  @@index([loanId])
  @@index([transactionDate])
  @@index([type])
  @@map("transactions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   // e.g. LOAN_CREATE, PAYMENT_RECORD, TRANSACTION_VOID
  entityName String   // e.g. Customer, Loan, Transaction
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityName])
  @@index([createdAt])
  @@map("audit_logs")
}
